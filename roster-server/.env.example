ROSTER_SUPABASE_URL=          # curriculum_render project: https://bzqbhtrurzzavhqbgqrs.supabase.co (D-G; §6.1 revised)
ROSTER_SUPABASE_SERVICE_KEY=  # service-role key, SERVER ONLY, never shipped to a client
ROSTER_TOKEN_SECRET=          # long random string for HMAC (e.g. openssl rand -hex 32)
ROSTER_TEACHER_SECRET=        # shared secret the teacher uses to enroll students
PORT=8090
ROSTER_PROCTOR_SECRET=        # gates evidence_tier=proctored writes (L-C); never client-side
WORK_MANIFEST_PATH=           # path to data/work-manifest.json (default: repo data dir)
ROSTER_PW_ENC_KEY=            # TR1: AES-256-GCM key for teacher-recoverable passwords.
                              # openssl rand -hex 32. SERVER ONLY, never client/git.
                              # Rotating it makes existing password_cipher unreadable
                              # (logins still work; each re-encrypts on next change).
