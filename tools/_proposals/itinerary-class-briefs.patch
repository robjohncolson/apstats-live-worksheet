@@ -471,6 +471,41 @@ def load_day_events(target: date) -> list:
         return []
 
 
+def load_briefs(target: date) -> list:
+    """One line per class section from the nightly brief index files (read-only, fail-soft:
+    a missing or malformed file is skipped silently).  Sections that meet before `target` are left out."""
+    files = [("AP Stats", Path(DEFAULTS["ap_repo"]) / "roster-local" / "brief" / "latest.json"),
+             ("Algebra 2", Path(DEFAULTS["a2_repo"]) / "roster-local" / "brief" / "latest.json")]
+    lines = []
+    for course, path in files:
+        try:
+            data = read_json(path)
+            if not isinstance(data, dict):
+                continue
+            stale = ""
+            written = datetime.fromisoformat(str(data.get("generatedAt")).replace("Z", "+00:00"))
+            if datetime.now(written.tzinfo) - written > timedelta(hours=36):
+                stale = f" (Brief is stale: written {written:%Y-%m-%d})"
+            pull = data.get("pull")
+            if isinstance(pull, dict) and pull.get("ok") is False:
+                lines.append(f"{course} summary pull FAILED last night: {clean(pull.get('reason') or 'no reason given', 120)}")
+            for sec in data.get("sections") or []:
+                nxt = date.fromisoformat(str(sec.get("nextMeeting")))
+                if nxt < target:
+                    continue
+                recent = sec.get("recentPromises")
+                line = f"{sec['section']} {nxt:%a} {nxt.month}/{nxt.day}: {sec.get('openPromises')} open promises"
+                line += f" ({recent} recent)" if recent is not None else ""
+                last = sec.get("lastRecording")
+                if last:
+                    last = date.fromisoformat(str(last))
+                    line += f", last recording {last.month}/{last.day}"
+                lines.append(line + stale)
+        except Exception:  # noqa: BLE001
+            log("brief read failed:\n" + traceback.format_exc())
+    return lines
+
