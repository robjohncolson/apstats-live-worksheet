registry-data.js

# CC browser automation rig (Edge CDP). edge.py IS tracked -- the Schoology
# grade-sync depends on it. Everything else here stays local: screenshots,
# __pycache__, and other dev artifacts. Real test-account credentials live
# OUTSIDE the repo (~/.claude/test-credentials.json); edge.py only holds a
# path to them.
tools/cdp/*
!tools/cdp/edge.py

